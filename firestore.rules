rules_version = '2';

// TestGO en Firebase (plan gratuito). Sin Cloud Functions, la seguridad está aquí:
// - Profesor: cuenta verificada de un dominio permitido y con su ficha activa. Solo ve y toca sus exámenes.
// - Administrador: los principales están fijos aquí; el resto se nombra desde el panel (ajustes/admins).
// - Alumno: sesión anónima. Solo crea y modifica su propio intento, dentro de su tiempo,
//   y nunca ve las soluciones (están en examenes/{E}, que solo lee el profesor).
//
// Ajustes del centro (solo los cambia un administrador):
//   ajustes/acceso    { dominios: ['edu.gva.es'], aprobarRegistros }  quién puede ser profesor
//   ajustes/admins    { correos: [...] }                              administradores además de los principales
//   ajustes/centro    { nombre, logo, mensajeAlumnos }
//   ajustes/examenes  { defectos: {...}, normas: {...} }
//   ajustes/aviso     { texto, tipo, activo, t }                      aviso para todos los profesores
//   profesores/{uid}  { email, estado: activo | pendiente | bloqueado, creado, ultimoAcceso }
service cloud.firestore {
  match /databases/{database}/documents {

    function conectado() {
      return request.auth != null;
    }

    function correoVerificado() {
      return conectado() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }

    function correo() {
      return request.auth.token.email.lower();
    }

    // Un ajuste del centro, o {} si todavía no se ha guardado nunca
    function ajuste(nombre) {
      return exists(/databases/$(database)/documents/ajustes/$(nombre))
        ? get(/databases/$(database)/documents/ajustes/$(nombre)).data
        : {};
    }

    // Administradores principales: fijos, no se pueden quitar desde el panel
    // (tiene que coincidir con ADMINS en web/js/config.js)
    function adminPrincipal() {
      return correoVerificado() && correo() in ['thedynat@gmail.com', 'dj.vidalsoriano@edu.gva.es'];
    }

    function admin() {
      return adminPrincipal() || (correoVerificado() && correo() in ajuste('admins').get('correos', []));
    }

    function dominioPermitido() {
      return correo().split('@')[1] in ajuste('acceso').get('dominios', ['edu.gva.es']);
    }

    function fichaProfesor() {
      return /databases/$(database)/documents/profesores/$(request.auth.uid);
    }

    // Sin ficha todavía no puede trabajar; una ficha antigua sin estado cuenta como activa
    function cuentaActiva() {
      return exists(fichaProfesor()) && get(fichaProfesor()).data.get('estado', 'activo') == 'activo';
    }

    function profesor() {
      return correoVerificado() && (admin() || (dominioPermitido() && cuentaActiva()));
    }

    // Dueño de un documento, o administrador
    function mio(datos) {
      return profesor() && (datos.propietario == request.auth.uid || admin());
    }

    function soyYo(uid) {
      return request.auth.uid == uid;
    }

    function publico(E) {
      return get(/databases/$(database)/documents/publico/$(E)).data;
    }

    function duenoDe(E) {
      return profesor() && exists(/databases/$(database)/documents/publico/$(E)) && mio(publico(E));
    }

    function cambia() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Normas del centro que ningún examen puede saltarse
    function cumpleNormas(d) {
      let n = ajuste('examenes').get('normas', {});
      return (n.get('marcaAgua', false) != true || d.marcaAgua == true)
        && (n.get('barajar', false) != true || d.barajar == true)
        && (n.get('ocultarNota', false) != true || d.mostrarNota == false)
        && (n.get('salidasMaximas', 0) == 0 || (d.maxSalidas >= 1 && d.maxSalidas <= n.get('salidasMaximas', 0)));
    }

    // ---------- Profesores ----------

    match /profesores/{uid} {
      // Cada uno lee su ficha (también si está pendiente o bloqueado, para saberlo)
      allow get: if conectado() && soyYo(uid);
      allow read: if admin();

      // La primera vez que entra se apunta él mismo: activo, o pendiente si el centro aprueba los registros
      allow create: if correoVerificado() && soyYo(uid)
        && (dominioPermitido() || admin())
        && request.resource.data.keys().hasOnly(['email', 'estado', 'creado', 'ultimoAcceso'])
        && request.resource.data.email == correo()
        && request.resource.data.creado == request.time
        && (request.resource.data.estado == 'pendiente'
            || (request.resource.data.estado == 'activo' && (admin() || ajuste('acceso').get('aprobarRegistros', false) != true)));

      // Después solo actualiza su correo y su último acceso; el estado no lo toca nunca
      allow update: if correoVerificado() && soyYo(uid)
        && cambia().hasOnly(['email', 'ultimoAcceso'])
        && request.resource.data.email == correo()
        && (!cambia().hasAny(['ultimoAcceso']) || request.resource.data.ultimoAcceso == request.time);

      // Un administrador aprueba, bloquea o desbloquea
      allow update: if admin()
        && cambia().hasOnly(['estado'])
        && request.resource.data.estado in ['activo', 'pendiente', 'bloqueado'];
    }

    // ---------- Ajustes del centro ----------

    // Se lee antes de iniciar sesión, para comprobar el dominio del correo
    match /ajustes/acceso {
      allow get: if true;
      allow write: if admin()
        && request.resource.data.keys().hasOnly(['dominios', 'aprobarRegistros'])
        && request.resource.data.dominios is list
        && request.resource.data.dominios.size() > 0
        && request.resource.data.dominios.size() <= 20
        && request.resource.data.aprobarRegistros is bool;
    }

    match /ajustes/admins {
      allow get: if conectado();
      allow write: if admin()
        && request.resource.data.keys().hasOnly(['correos'])
        && request.resource.data.correos is list
        && request.resource.data.correos.size() <= 50;
    }

    match /ajustes/centro {
      allow get: if conectado();
      allow write: if admin()
        && request.resource.data.keys().hasOnly(['nombre', 'logo', 'mensajeAlumnos'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() <= 150
        && (request.resource.data.logo == null || request.resource.data.logo is string)
        && (!('mensajeAlumnos' in request.resource.data) || (request.resource.data.mensajeAlumnos is string && request.resource.data.mensajeAlumnos.size() <= 300));
    }

    // Los alumnos también lo leen: las normas dicen si en los exámenes se puede copiar y pegar
    match /ajustes/examenes {
      allow get: if conectado();
      allow write: if admin()
        && request.resource.data.keys().hasOnly(['defectos', 'normas'])
        && request.resource.data.defectos is map
        && request.resource.data.normas is map;
    }

    match /ajustes/aviso {
      allow get: if profesor();
      allow write: if admin()
        && request.resource.data.keys().hasOnly(['texto', 'tipo', 'activo', 't'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 500
        && request.resource.data.tipo in ['info', 'aviso', 'urgente']
        && request.resource.data.activo is bool;
    }

    // Uso del centro: el administrador cuenta los intentos de todos los exámenes
    match /{camino=**}/intentos/{uid} {
      allow list: if admin();
    }

    // ---------- Exámenes completos (con soluciones) ----------

    match /examenes/{E} {
      allow read, delete: if mio(resource.data);
      allow update: if mio(resource.data) && request.resource.data.propietario == resource.data.propietario;
      allow create: if profesor() && request.resource.data.propietario == request.auth.uid;
    }

    // ---------- Códigos ----------

    match /codigos/{codigo} {
      allow get: if conectado();
      allow create: if mio(request.resource.data);
      allow delete: if mio(resource.data);
    }

    // ---------- Imágenes (en Firestore: el plan gratuito no tiene Storage) ----------

    match /imagenes/{id} {
      allow get: if conectado();
      allow create: if profesor()
        && request.resource.data.propietario == request.auth.uid
        && request.resource.data.datos is string
        && request.resource.data.datos.size() < 950000
        && request.resource.data.datos.split(';base64,')[0] in ['data:image/png', 'data:image/jpeg', 'data:image/webp', 'data:image/gif'];
      allow delete: if mio(resource.data);
    }

    // ---------- Lo que ve el alumno ----------

    match /publico/{E} {
      allow get: if conectado();
      allow create: if profesor() && request.resource.data.propietario == request.auth.uid && cumpleNormas(request.resource.data);
      allow delete: if mio(resource.data);
      // Las normas se comprueban cuando cambia algún ajuste de control (así cambiar el logo no falla en exámenes antiguos)
      allow update: if mio(resource.data) && request.resource.data.propietario == resource.data.propietario
        && (!cambia().hasAny(['marcaAgua', 'barajar', 'mostrarNota', 'maxSalidas']) || cumpleNormas(request.resource.data));

      // Un intento por nombre: { uid } del alumno que lo tiene
      match /nombres/{clave} {
        allow read, write: if duenoDe(E);
        allow get: if conectado();
        allow create: if conectado()
          && publico(E).abierto == true
          && request.resource.data.keys().hasOnly(['uid', 'nombre'])
          && request.resource.data.uid == request.auth.uid
          && exists(/databases/$(database)/documents/publico/$(E)/intentos/$(request.auth.uid)) == false
          && getAfter(/databases/$(database)/documents/publico/$(E)/intentos/$(request.auth.uid)).data.nombreClave == clave;
      }

      // Alumno que pide volver a entrar desde otro equipo
      match /solicitudes/{uid} {
        allow read, delete: if duenoDe(E);
        allow create, update: if conectado() && soyYo(uid)
          && request.resource.data.keys().hasOnly(['nombre', 'nombreClave', 't'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() <= 80
          && request.resource.data.t == request.time;
      }

      match /intentos/{uid} {
        allow read, write: if duenoDe(E);
        allow get: if conectado() && soyYo(uid);

        // Al entrar: con el examen abierto, su propio nombre reservado y todo a cero
        allow create: if conectado() && soyYo(uid)
          && publico(E).abierto == true
          && request.resource.data.semilla == uid
          && request.resource.data.estado == 'en_curso'
          && request.resource.data.inicio == null
          && request.resource.data.duracion == publico(E).duracion
          && request.resource.data.minutosExtra == 0
          && request.resource.data.salidas == 0
          && request.resource.data.baseSalidas == 0
          && request.resource.data.respuestas.size() == 0
          && request.resource.data.notasManual.size() == 0
          && request.resource.data.creado == request.time
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() >= 3
          && request.resource.data.nombre.size() <= 80
          && request.resource.data.keys().hasOnly(['nombre', 'nombreClave', 'semilla', 'estado', 'creado', 'inicio', 'duracion',
               'minutosExtra', 'orden', 'respuestas', 'salidas', 'baseSalidas', 'ultimaIncidencia', 'ultimaSenal',
               'entregadoEn', 'motivoEntrega', 'notasManual', 'navegador'])
          && getAfter(/databases/$(database)/documents/publico/$(E)/nombres/$(request.resource.data.nombreClave)).data.uid == uid;

        // Mientras hace el examen: solo estos campos, y nunca su tiempo, su nota ni sus salidas permitidas
        allow update: if conectado() && soyYo(uid)
          && resource.data.estado != 'entregado'
          && cambia().hasOnly(['respuestas', 'inicio', 'salidas', 'estado', 'bloqueadoPor', 'ultimaSenal',
               'ultimaIncidencia', 'entregadoEn', 'motivoEntrega', 'posicion'])
          && inicioValido()
          && salidasValidas()
          && estadoValido()
          && respuestasValidas()
          && (!cambia().hasAny(['ultimaSenal']) || request.resource.data.ultimaSenal == request.time);

        function limite() {
          return resource.data.inicio + duration.value((resource.data.duracion + resource.data.minutosExtra) * 60 + 60, 's');
        }

        // Empieza una sola vez, con la hora de Firebase
        function inicioValido() {
          return !cambia().hasAny(['inicio'])
            || (resource.data.inicio == null && request.resource.data.inicio == request.time && resource.data.estado == 'en_curso');
        }

        // Las salidas solo suben de una en una
        function salidasValidas() {
          return !cambia().hasAny(['salidas']) || request.resource.data.salidas == resource.data.salidas + 1;
        }

        // Puede bloquearse (por salir) o entregar; desbloquearse no
        function estadoValido() {
          return !cambia().hasAny(['estado', 'bloqueadoPor', 'entregadoEn', 'motivoEntrega'])
            || (request.resource.data.estado == 'bloqueado' && resource.data.estado == 'en_curso' && request.resource.data.bloqueadoPor == 'automatico')
            || (request.resource.data.estado == 'entregado' && resource.data.estado == 'en_curso' && resource.data.inicio != null
                && request.resource.data.entregadoEn == request.time);
        }

        // Responder solo con el examen en curso y dentro del tiempo (con un minuto de margen)
        function respuestasValidas() {
          return !cambia().hasAny(['respuestas'])
            || (resource.data.estado == 'en_curso' && resource.data.inicio != null && request.time < limite());
        }

        match /incidencias/{id} {
          allow read, write: if duenoDe(E);
          allow create: if conectado() && soyYo(uid)
            && request.resource.data.keys().hasOnly(['t', 'tipo', 'detalle'])
            && request.resource.data.t == request.time
            && request.resource.data.tipo in ['inicio', 'salida', 'regreso', 'copiar', 'pegar', 'menu', 'imprimir', 'bloqueo', 'entrega']
            && request.resource.data.detalle is string
            && request.resource.data.detalle.size() <= 300;
        }
      }
    }
  }
}
